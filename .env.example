# Benchmark configuration.
#
#   cp .env.example .env
#
# Then fill in the blanks below. Real environment variables take precedence over
# this file, so CI can export the same names instead of shipping a .env.
# Run `python app.py --dry-run` to list anything still missing.
#
# AZURE_* identifies the resource under test. BENCH_* records deployment
# metadata and methodology. Review model, region, client, and SKU values for
# your resource; keep the load settings unchanged for a comparable experiment.

# ---------------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------------

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=v1

# Set to true only once you have confirmed the v1 API against your own resource.
AZURE_OPENAI_API_VERSION_VERIFIED=false

# ---------------------------------------------------------------------------
# Resource identity (recorded in the run manifest for provenance)
# ---------------------------------------------------------------------------
#
# Do not put API keys, client secrets, access tokens, or passwords in this file.
# Prefer `az login`, managed identity, or workload identity. If automation needs
# a secret, inject it from a secret store into the process environment.

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_PROJECT=

# ---------------------------------------------------------------------------
# Deployments
# ---------------------------------------------------------------------------
#
# Any AZURE_DEPLOYMENT_<LABEL> variable adds a deployment. The label is the
# suffix lowercased with underscores turned into hyphens, so
# AZURE_DEPLOYMENT_GLOBAL_STANDARD becomes the label "global-standard" that
# `--only global-standard` selects. Add a third deployment by adding a third
# variable plus its matching BENCH_SKU_* pair.

AZURE_DEPLOYMENT_GLOBAL_STANDARD=
AZURE_DEPLOYMENT_PROVISIONED=

# Capacity is deployment metadata; these values do not resize Azure resources.
# Global Standard uses thousands of TPM (1350 = 1,350,000 TPM), while
# Global Provisioned uses PTUs (45 = 45 PTUs).
BENCH_SKU_GLOBAL_STANDARD_NAME=GlobalStandard
BENCH_SKU_GLOBAL_STANDARD_CAPACITY=1350
BENCH_SKU_PROVISIONED_NAME=GlobalProvisionedManaged
BENCH_SKU_PROVISIONED_CAPACITY=45

# ---------------------------------------------------------------------------
# Model under test
# ---------------------------------------------------------------------------

BENCH_MODEL_NAME=gpt-5.6-luna
BENCH_MODEL_VERSION=2026-07-09
BENCH_MODEL_FORMAT=OpenAI
BENCH_REGION=swedencentral
BENCH_CONTENT_FILTER_POLICY=Microsoft.DefaultV2
BENCH_VERSION_UPGRADE_POLICY=NoAutoUpgrade
# Descriptive metadata recorded in the manifest; this does not control routing.
BENCH_ROUTING_SCOPE="global for both deployment types"

# Where you run the benchmark from. Client latency is meaningless without it.
BENCH_CLIENT_LOCATION=

# ---------------------------------------------------------------------------
# Load matrix
# ---------------------------------------------------------------------------
#
# Lists are comma separated. offered_load_rpm needs a level below, at, and above
# BENCH_TARGET_RPM; streaming_load_rpm needs below and at. concurrency_levels
# must include the baseline level 1. The 480-RPM target is calibrated to the
# default RAG workload and Luna's 6:1 output-to-input normalization ratio.

BENCH_TARGET_RPM=480
BENCH_CONCURRENCY_LEVELS=1,8,32
BENCH_OFFERED_LOAD_RPM=240,480,720
BENCH_STREAMING_LOAD_RPM=240,480

# JSON array, one object per workload.
BENCH_WORKLOADS='[{"name":"short-chat","input_tokens":200,"max_output_tokens":100},{"name":"rag","input_tokens":1000,"max_output_tokens":300},{"name":"long-gen","input_tokens":500,"max_output_tokens":1000}]'

# ---------------------------------------------------------------------------
# Run control
# ---------------------------------------------------------------------------

BENCH_SEED=20260727
BENCH_TRIALS=3
BENCH_TRIAL_DURATION_S=50
BENCH_INTER_TRIAL_PAUSE_S=3
BENCH_MAX_RUN_DURATION_S=8700
BENCH_SHUTDOWN_GRACE_S=10
BENCH_WARMUP_REQUESTS=5

BENCH_CONNECT_TIMEOUT_S=10
BENCH_READ_TIMEOUT_S=180
BENCH_MAX_IN_FLIGHT=64

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
#
# BENCH_GENERATION_EXTRA_PARAMS is a JSON object merged into every request. It
# cannot override model, messages, stream, stream_options, or the token param.

BENCH_TOKEN_PARAM=max_completion_tokens
BENCH_GENERATION_EXTRA_PARAMS='{"reasoning_effort":"none"}'

BENCH_OUTPUT_DIR=results
